<Window x:Class="MooZip.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" Title="MooZip" Icon="Assets/MooZip.ico" Width="1140" Height="730" MinWidth="850" MinHeight="570" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Dropped" PreviewDragOver="DragEntered" PreviewKeyDown="Shortcut">
<shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="35" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
<Grid Margin="16,0,16,16"><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition/></Grid.RowDefinitions>
<DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
<StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="11"/><Setter Property="Width" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></Style></StackPanel.Resources>
<Button Content="&#xE921;" ToolTip="최소화" AutomationProperties.Name="최소화" Click="Minimize"/><Button Content="&#xE922;" ToolTip="창 크기 전환" AutomationProperties.Name="창 크기 전환" Click="Maximize"/><Button Content="&#xE8BB;" ToolTip="닫기" AutomationProperties.Name="닫기" Click="CloseApp"/></StackPanel>
<TextBlock Text="MooZip" VerticalAlignment="Center" Margin="4,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/></DockPanel>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="12"/><ColumnDefinition Width="208"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource Rail}" CornerRadius="14"><DockPanel Margin="6,12">
<Button DockPanel.Dock="Top" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,18" Click="Home" ToolTip="홈" AutomationProperties.Name="홈"><Image Source="Assets/MooZip.png" Width="37" Height="37"/></Button>
<Button DockPanel.Dock="Bottom" Style="{StaticResource RailButton}" Content="&#xE706;" Click="Theme" ToolTip="밝은 테마 / 어두운 테마" AutomationProperties.Name="테마 전환"/>
<StackPanel><Button Style="{StaticResource RailButton}" Content="&#xE8E5;" Click="OpenClicked" ToolTip="압축 파일 열기 (Ctrl+O)" AutomationProperties.Name="압축 파일 열기"/><Button Style="{StaticResource RailButton}" Content="&#xE710;" Click="NewClicked" ToolTip="새로 압축 (Ctrl+N)" AutomationProperties.Name="새로 압축"/></StackPanel>
</DockPanel></Border>
<Border Grid.Column="2" Style="{StaticResource Card}" Padding="17,24"><DockPanel>
<StackPanel DockPanel.Dock="Top"><TextBlock Text="MooZip" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="압축 파일 관리자" Style="{StaticResource Caption}" Margin="1,3,0,25"/>
<Border Height="1" Background="{DynamicResource Edge}" Margin="0,0,0,20"/>
<TextBlock Text="최근 압축 파일" FontWeight="SemiBold" Margin="0,0,0,12"/>
</StackPanel>
<StackPanel DockPanel.Dock="Bottom"><Border Height="1" Background="{DynamicResource Edge}" Margin="0,16"/>
<Button Content="탐색기 메뉴 등록" Margin="0,0,0,6" Click="RegisterMenuClicked" ToolTip="이 포터블 폴더의 MooZip을 Windows 탐색기 우클릭 메뉴에 등록"/><Button Content="기본 앱 설정…" Click="DefaultAppsClicked" Margin="0,0,0,14" ToolTip="ZIP, 7Z, RAR, TAR 기본 앱 연결"/><TextBlock Text="지원 형식" Style="{StaticResource Caption}"/><TextBlock Text="ZIP · 7Z · RAR · TAR" FontSize="12" Margin="0,6,0,0" FontWeight="SemiBold"/></StackPanel>
<Grid><TextBlock x:Name="NoRecent" Text="연 파일이 여기에 표시됩니다." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6"/>
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="RecentList"/></ScrollViewer></Grid></DockPanel></Border>
<Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="10"/><RowDefinition Height="56"/></Grid.RowDefinitions>
<Border Style="{StaticResource Card}" Padding="24,20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel><TextBlock x:Name="Heading" Foreground="{DynamicResource Ink}" Text="압축 작업 공간" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,12,0"/></StackPanel>
<TextBlock x:Name="FormatTag" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontWeight="SemiBold"/></Grid>
<Grid Grid.Row="1" Margin="0,18,0,0">
<Border x:Name="Landing" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" CornerRadius="12">
<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12">
<Viewbox Width="155" Height="127" Margin="0,0,0,23"><Canvas Width="170" Height="140">
<Path Data="M13,119 L80,86 155,119 88,139 Z" Fill="#CCD9D1"/>
<Path Data="M22,65 L83,36 146,66 85,97 Z" Fill="#B7D8C3" Stroke="#2D4C3B" StrokeThickness="2.6" StrokeLineJoin="Round"/>
<Path Data="M22,65 L85,95 85,130 22,99 Z" Fill="#82A68F" Stroke="#2D4C3B" StrokeThickness="2.6" StrokeLineJoin="Round"/>
<Path Data="M85,95 L146,66 146,100 85,130 Z" Fill="#5D836C" Stroke="#2D4C3B" StrokeThickness="2.6" StrokeLineJoin="Round"/>
<Path Data="M33,49 L85,24 136,49 84,75 Z" Fill="#EAF2EB" Stroke="#557860" StrokeThickness="2.3" StrokeLineJoin="Round"/>
<Path Data="M36,36 L86,12 135,36 84,61 Z" Fill="#F7FAF7" Stroke="#557860" StrokeThickness="2.3" StrokeLineJoin="Round"/>
<Path Data="M61,36 L86,24 M69,39 L94,27" Stroke="#91AF9B" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
<Path Data="M43,85 L59,93" Stroke="#E5F1E7" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
</Canvas></Viewbox>
<TextBlock Text="파일을 여기에 놓으세요" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
<TextBlock Text="압축 파일을 열거나 파일과 폴더를 모아 압축하세요." FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,10,0,22"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="압축 파일 열기" Style="{StaticResource Primary}" Padding="19,10" Click="OpenClicked"/><Button Content="새로 압축" Margin="8,0,0,0" Padding="19,10" Click="NewClicked"/></StackPanel>
</StackPanel></Border>
<Grid x:Name="BrowserPane" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
<WrapPanel Margin="0,0,0,12"><Button Content="알아서 풀기" Style="{StaticResource Primary}" Click="SmartClicked" ToolTip="압축 파일이 있는 위치에 내부 구조에 맞춰 풀기"/>
<Button Content="전체 풀기…" Margin="6,0,0,0" Click="AllClicked"/><Button x:Name="SelectedButton" Content="선택 풀기…" Margin="6,0,0,0" Click="SelectedClicked"/><Button Content="검사" Margin="6,0,0,0" Click="TestClicked" ToolTip="모든 항목을 읽어 무결성 검사"/></WrapPanel>
<DockPanel Grid.Row="1" Margin="0,0,0,10"><TextBlock Text="검색" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="SearchBox" AutomationProperties.Name="파일 이름 또는 경로 검색" ToolTip="파일 이름 또는 경로 검색 (Ctrl+F)" TextChanged="FilterChanged"/></DockPanel>
<Grid Grid.Row="2"><DataGrid x:Name="MemberGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" CanUserReorderColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" RowBackground="{DynamicResource Surface}" RowHeight="36" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Edge}" BorderBrush="{DynamicResource Edge}" BorderThickness="1" EnableRowVirtualization="True" SelectionChanged="SelectionChanged">
<DataGrid.Resources><SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#557860"/><SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/></DataGrid.Resources>
<DataGrid.Columns><DataGridTemplateColumn Header="이름" Width="2.4*" MinWidth="155" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate><DockPanel><TextBlock Text="{Binding Symbol}" FontFamily="Segoe MDL2 Assets" Foreground="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=Foreground}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=Foreground}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/></DockPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
<DataGridTextColumn Header="경로" Binding="{Binding Location}" Width="1.3*" MinWidth="79"/><DataGridTextColumn Header="형식" Binding="{Binding Kind}" Width="67"/><DataGridTextColumn Header="크기" Binding="{Binding Bytes}" SortMemberPath="Size" Width="106"/></DataGrid.Columns></DataGrid>
<TextBlock x:Name="NoMatches" Text="표시할 항목이 없습니다." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Visibility="Collapsed"/></Grid></Grid>
</Grid></Grid></Border>
<Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,8"><DockPanel>
<Button x:Name="CancelJob" Content="취소" DockPanel.Dock="Right" Visibility="Collapsed" Click="CancelClicked"/>
<Button x:Name="OpenResult" Content="결과 폴더 열기" DockPanel.Dock="Right" Visibility="Collapsed" Click="ShowResult"/>
<ProgressBar x:Name="Meter" Width="100" Height="5" DockPanel.Dock="Right" Visibility="Collapsed" Foreground="#759F83" Margin="8,0" Maximum="1"/>
<TextBlock x:Name="Status" Text="준비됨" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelativeSource={RelativeSource Self},Path=Text}"/></DockPanel></Border>
</Grid></Grid></Grid></Window>

